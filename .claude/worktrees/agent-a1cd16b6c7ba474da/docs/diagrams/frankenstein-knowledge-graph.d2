direction: right

vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 200
  }
}

classes: {
  person: {
    shape: person
    style.fill: "#42A5F5"
    style.stroke: "#1565C0"
    style.font-color: "#fff"
  }
  place: {
    shape: hexagon
    style.fill: "#66BB6A"
    style.stroke: "#2E7D32"
    style.font-color: "#fff"
  }
  project: {
    shape: page
    style.fill: "#FFA726"
    style.stroke: "#E65100"
    style.font-color: "#fff"
  }
  concept: {
    shape: diamond
    style.fill: "#AB47BC"
    style.stroke: "#6A1B9A"
    style.font-color: "#fff"
  }
  other: {
    shape: rectangle
    style.fill: "#BDBDBD"
    style.stroke: "#616161"
    style.font-color: "#333"
  }
  fact: {
    style.stroke: "#E0E0E0"
    style.font-size: 13
    style.italic: true
  }
}

# ═══════════════════════════════════════
# Connected subgraph
# ═══════════════════════════════════════

FRANKENSTEIN.class: other
prometheus.class: concept
United States.class: place
Margaret.class: person
London.class: place
PROJECT GUTENBERG.class: project
"www.gutenberg.org".class: other
Project Gutenberg License.class: concept
sister.class: person
undertaking.class: concept

# ── Relationships ──

FRANKENSTEIN -> prometheus: knows_about {
  class: fact
  style.stroke: "#AB47BC"
}
FRANKENSTEIN -> United States: lives_in {
  class: fact
  style.stroke: "#66BB6A"
}
Margaret -> London: knows {
  class: fact
  style.stroke: "#42A5F5"
}
PROJECT GUTENBERG -> FRANKENSTEIN: created {
  class: fact
  style.stroke: "#FFA726"
  style.stroke-width: 3
}
PROJECT GUTENBERG -> "www.gutenberg.org": owns {
  class: fact
  style.stroke: "#FFA726"
}
Project Gutenberg License -> PROJECT GUTENBERG: member_of {
  class: fact
  style.stroke: "#AB47BC"
}
sister -> undertaking: knows_about {
  class: fact
  style.stroke: "#AB47BC"
}

# ═══════════════════════════════════════
# Disconnected entities (no relationships yet)
# ═══════════════════════════════════════

Unlinked Entities: {
  style.fill: "#1a1a2e"
  style.stroke: "#333"
  style.border-radius: 8
  style.font-color: "#999"

  grid-rows: 3

  Al Haines.class: person
  Christy Phillips.class: person
  David Meltzer.class: person
  Homer.class: person
  Judith Boss.class: person
  Lynn Hanninen.class: person
  Menno de Leeuw.class: person
  Shakespeare.class: person
  Uncle Thomas.class: person
  "eBook #84".class: project
  enterprise.class: concept
  North Pacific Ocean.class: place
  "October 1, 1993".class: other
  Petersburgh.class: place
  "www.gutenberg.org/ebooks/84".class: project
}

# ═══════════════════════════════════════
# Legend
# ═══════════════════════════════════════

legend: {
  near: bottom-right
  style.fill: "#111"
  style.stroke: "#333"
  style.border-radius: 6
  style.font-color: "#ccc"
  style.font-size: 12

  grid-rows: 5
  grid-columns: 2
  grid-gap: 4

  l1: Person {shape: person; style.fill: "#42A5F5"; style.font-size: 11}
  l1v: "" {style.fill: transparent; style.stroke: transparent}
  l2: Place {shape: hexagon; style.fill: "#66BB6A"; style.font-size: 11}
  l2v: "" {style.fill: transparent; style.stroke: transparent}
  l3: Project {shape: page; style.fill: "#FFA726"; style.font-size: 11}
  l3v: "" {style.fill: transparent; style.stroke: transparent}
  l4: Concept {shape: diamond; style.fill: "#AB47BC"; style.font-size: 11}
  l4v: "" {style.fill: transparent; style.stroke: transparent}
  l5: Other {shape: rectangle; style.fill: "#BDBDBD"; style.font-size: 11}
  l5v: "" {style.fill: transparent; style.stroke: transparent}
}
