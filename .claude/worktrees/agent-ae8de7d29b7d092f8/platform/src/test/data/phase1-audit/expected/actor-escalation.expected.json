{
  "scenario": "actor-escalation",
  "data_set_level": 2,
  "phase": "phase1-audit",
  "fixture": "phase1-audit/fixtures/actor-escalation.sql",
  "description": "Single fact traverses all seven valid actors over a seven-step lifecycle; audit trail records every mutation in correct order with correct attribution.",
  "pre_seed": { "entities": 3, "facts": 1, "reasoning_reports": 1, "fact_history": 1 },
  "mutation_sequence_harness_driven": [
    { "step": 1, "pre_seeded": true, "actor": "graph_agent",          "event_type": "created" },
    { "step": 2, "service_call": "updateFactConfidence", "actor": "reasoning_agent",      "event_type": "confidence_raised",  "previous_confidence": 0.70, "new_confidence": 0.88, "reasoning_report_id": "50000000-0000-0000-0000-000000000001", "offset_hours": 1 },
    { "step": 3, "service_call": "reviseFact",          "actor": "gardener_agent",       "event_type": "revised",            "offset_hours": 2, "reasoning_contains": "merge" },
    { "step": 4, "service_call": "reviseFact",          "actor": "reconciliation_agent", "event_type": "revised",            "offset_hours": 3, "reasoning_contains": "merge-candidate" },
    { "step": 5, "service_call": "invalidateFact",      "actor": "user",                 "event_type": "invalidated",        "offset_hours": 4, "new_invalid_at_not_null": true },
    { "step": 6, "service_call": "restoreFact",         "actor": "system_trigger",       "event_type": "restored",           "offset_hours": 5 },
    { "step": 7, "service_call": "expireFact",          "actor": "cascade",              "event_type": "expired",            "offset_hours": 6, "causal_event_id_required": true }
  ],
  "assertions": [
    { "type": "row_count", "table": "fact_history", "filter": { "fact_id": "10000000-0000-0000-0000-000000000001" }, "expected": 7, "because": "seed + 6 service-driven mutations" },
    { "type": "column_sequence", "table": "fact_history", "filter": { "fact_id": "10000000-0000-0000-0000-000000000001" }, "order_by": "occurred_at ASC", "column": "event_type", "expected": ["created","confidence_raised","revised","revised","invalidated","restored","expired"] },
    { "type": "column_sequence", "table": "fact_history", "filter": { "fact_id": "10000000-0000-0000-0000-000000000001" }, "order_by": "occurred_at ASC", "column": "actor", "expected": ["graph_agent","reasoning_agent","gardener_agent","reconciliation_agent","user","system_trigger","cascade"] },
    { "type": "actor_distribution", "filter": { "fact_id": "10000000-0000-0000-0000-000000000001" }, "expected": { "graph_agent": 1, "reasoning_agent": 1, "gardener_agent": 1, "reconciliation_agent": 1, "user": 1, "system_trigger": 1, "cascade": 1 }, "because": "all 7 actors exercised exactly once" },
    { "type": "foreign_key_integrity", "table": "fact_history", "columns": ["reasoning_report_id","causal_event_id","fact_id"], "rule": "non_null_values_reference_existing_rows", "expected_violations": 0 },
    { "type": "non_null", "table": "fact_history", "columns": ["reasoning","actor","event_type"], "because": "NOT NULL criteria" },
    { "type": "column_values", "filter": { "actor": "cascade" }, "assertions": [ { "column": "causal_event_id", "not_null": true, "because": "cascade rows must reference the upstream cause" } ] }
  ],
  "benchmark_targets": {
    "fixture_load_ms_p95": 150,
    "mutation_sequence_end_to_end_ms_p95": 800,
    "audit_query_reverse_chronological_ms_p95": 20
  },
  "adversarial_variants": [
    { "fixture": "actor-escalation-wrong-actor-for-cascade.sql", "expected_failure_mode": "business_rule:cascade_requires_upstream_reference" },
    { "fixture": "actor-escalation-unknown-actor.sql",          "expected_failure_mode": "db_constraint:valid_fact_actor" }
  ],
  "graduation_notes": "Promote to L3 when multiple facts are audited concurrently with overlapping actor sequences; actor attribution under transaction rollback (partial sequence must not leave orphan audit rows); occurred_at collisions within 1ms resolved deterministically."
}
