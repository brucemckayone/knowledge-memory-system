# Copy to .env and fill in values

# Telegram Bot (required)
BOT_NAME=your_bot_name
TELEGRAM_BOT_TOKEN=your_bot_token

# Webhook URL (optional - for Cloudflare Tunnel)
# - Quick tunnels (make dev): Leave empty, auto-detected
# - Named tunnels (make dev-named): Set to your domain
# WEBHOOK_URL=https://bot.yourdomain.com

# Postgres password (for docker-compose)
POSTGRES_PASSWORD=cognitive

# Z.AI API for GLM-4.7 model (replaces Ollama)
# Get your API key from: https://open.bigmodel.cn/
ZAI_API_KEY=your_zai_api_key

# ================================================================
# Phase 5: Enhanced Task Processing Configuration
# ================================================================

# Enhanced LLM Configuration
# Provider for enhanced task extraction (decomposition, dependencies)
ENHANCED_LLM_PROVIDER=zai
ENHANCED_LLM_MODEL=glm-4.7
# ENHANCED_LLM_API_KEY=your_enhanced_api_key  # Optional, falls back to ZAI_API_KEY
# ENHANCED_LLM_BASE_URL=https://api.z.ai/api/paas/v4/

# Pattern Analysis Configuration
GARDENER_PATTERN_ANALYSIS_ENABLED=true
GARDENER_PATTERN_ANALYSIS_INTERVAL=1h

# Semantic Deduplication
SEMANTIC_DUPLICATE_ENABLED=true
SEMANTIC_DUPLICATE_THRESHOLD=0.90
