# Copy to .env and fill in values

# Telegram Bot (required)
BOT_NAME=your_bot_name
TELEGRAM_BOT_TOKEN=your_bot_token

# Webhook URL (optional - for Cloudflare Tunnel)
# - Quick tunnels (make dev): Leave empty, auto-detected
# - Named tunnels (make dev-named): Set to your domain
# WEBHOOK_URL=https://bot.yourdomain.com

# Postgres password (for docker-compose)
POSTGRES_PASSWORD=cognitive

# Z.AI API for GLM-4.7 model (replaces Ollama)
# Get your API key from: https://open.bigmodel.cn/
ZAI_API_KEY=your_zai_api_key
