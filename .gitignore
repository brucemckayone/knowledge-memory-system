# Dependencies
node_modules/
__pycache__/
*.pyc
.venv/
venv/

# Build
dist/
build/
*.egg-info/

# Environment
.env
.env.local
.env.*.local

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Docker
.docker/

# Database
*.db
*.sqlite

# Qdrant data (if local)
qdrant_storage/

# Generated MCP configs
.causal-mcp-config.json
.graph-mcp-config.*.json

# Claude Code transient state
**/.claude/scheduled_tasks.lock
# Agent-tool worktree scratch (isolated agent runs); cleaned up automatically
.claude/worktrees/

# Per-session scratch directories (review notes, finding bodies, diff dumps)
.tmp/
**/.tmp/

# Drizzle
drizzle/
.beads/daemon.lock
.beads/*.db

# Beads / Dolt files (added by bd init)
.dolt/
.beads-credential-key
test-data/

# Snapshot cache (per-machine; manifest is the source of truth)
platform/test-snapshots/

# Playwright MCP transient page snapshots (accessibility-tree dumps from
# browser debugging). The committed PNGs in .playwright-mcp/ are intentional;
# only the auto-generated page-*.yml snapshots are noise.
**/.playwright-mcp/page-*.yml

# Windows reserved-name junk file (accidental `> nul` redirect output)
platform/nul

# Runtime log offset cursor (per-machine; single byte-offset value)
/.logbase

# Benchmark harness scratch — throwaway venv, generated dashboards, one-off
# analysis scripts. doc 39's snapshot store (nmemo-hm4.2 retention decision):
# history.jsonl + gold/ + per-run manifest.json/metrics.json/report.md are
# TRACKED (trend over commits, §3.3); the bulky regenerable per-run graph dumps
# (*.canonical.json / *.rich.json) are ignored.
platform/benchmark-results/.venv/
platform/benchmark-results/*.png
platform/benchmark-results/*.py
platform/benchmark-results/runs/**/*.canonical.json
platform/benchmark-results/runs/**/*.rich.json

# Local run logs and DB backups (large binary dumps)
.run-logs/

# Regenerable embedding cache (96MB) — rebuild with desc-aligned-recall.ts
docs/architecture/single-graph/prereg-artifacts/embed-cache.json
docs/architecture/single-graph/prereg-artifacts/arxiv-embed-cache.json

# Derived embedding caches + large pool/score dumps regenerated by the
# retrieval-eval harnesses (docs 05-47). Tracked artifacts in prereg-artifacts/
# are results summaries (<1MB); these are multi-MB byproducts.
docs/architecture/single-graph/prereg-artifacts/*-embed-cache.json
docs/architecture/single-graph/prereg-artifacts/rerank-pool-*.json
docs/architecture/single-graph/prereg-artifacts/rerank-scores-*.json
docs/architecture/single-graph/prereg-artifacts/heldout-communities-*.json
