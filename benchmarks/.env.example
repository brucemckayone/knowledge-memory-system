# Copy to .env and fill in. .env is gitignored.

# Mnemo platform URL. Defaults to http://localhost:3000; override here if your
# platform/.env has PORT=3001 (it does on this machine — see ../platform/.env).
MNEMO_PLATFORM_URL=http://localhost:3001

# Anthropic API key for the Sonnet judge. If you use Z.AI as a Claude-
# compatible provider instead, set ZAI_API_KEY and pass it through via
# _common/judge.py (custom base_url).
ANTHROPIC_API_KEY=
