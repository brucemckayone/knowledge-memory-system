# Server
PORT=3000
NODE_ENV=development

# Database (pg-boss uses this for queue too)
DATABASE_URL=postgres://cognitive:cognitive@localhost:5432/cognitive

# Qdrant
QDRANT_URL=http://localhost:6333

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Webhook URL (optional - for Cloudflare Tunnel)
# Leave empty for quick tunnels (auto-detected by make dev)
# WEBHOOK_URL=https://bot.yourdomain.com

# ML Services
ML_SERVICES_URL=http://localhost:8000

# Embedding model (dimensions derived from model map in config.ts)
# Override with EMBED_DIMENSIONS for models not in the map
EMBED_MODEL=nomic-embed-text
# EMBED_DIMENSIONS=768

# Entity vectors embed a name+description composite instead of the bare name.
# Accepts true/1/yes/on and false/0/no/off; anything else fails at startup.
# EMBED_DESCRIPTIONS=false

# Promote-time predicate fold. LEAVE THIS OFF. Doc 41 §7 measured it at a 3.7%
# predicate reduction against a 60% bar with 0.43 merge precision, and a bad
# merge is unrecoverable — off is the decision of record, not a pending setup
# step. Also gates scripts/backfill-predicate-embeddings.ts, which arms the fold.
# PREDICATE_FOLD_ENABLED=false

# Queue
QUEUE_CONCURRENCY=2
