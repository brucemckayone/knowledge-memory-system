{
  "scenario": "decay-battlefield",
  "version": "1.0",
  "data_set_level": 2,
  "fixture": "phase2-lifecycle/fixtures/decay-battlefield.sql",
  "description": "100 edges in 6 cohorts exercising every branch of applyConfidenceDecay's skip/decay decision tree.",
  "cohorts": [
    { "ids_range": "1..60",  "count": 60, "category": "decay_target", "expected_outcome": "decayed",   "rationale": "stale (60d) + corroboration_count=1 + strength=0.6 + extraction_method=llm" },
    { "ids_range": "61..70", "count": 10, "category": "fresh",        "expected_outcome": "skipped",   "rationale": "last_corroborated within ageDays threshold (5d)" },
    { "ids_range": "71..80", "count": 10, "category": "multi",        "expected_outcome": "skipped",   "rationale": "corroboration_count=3 (>1)" },
    { "ids_range": "81..90", "count": 10, "category": "at_floor",     "expected_outcome": "skipped",   "rationale": "strength=0.05 <= DEFAULT_DECAY_FLOOR (0.1)" },
    { "ids_range": "91..95", "count":  5, "category": "expired",      "expected_outcome": "skipped",   "rationale": "expired_at non-null (pre-seeded expired)" },
    { "ids_range": "96..100","count":  5, "category": "non_llm",      "expected_outcome": "skipped",   "rationale": "extraction_method='manual' (only 'llm' is decay-eligible)" }
  ],
  "assertions": [
    {
      "type": "row_count",
      "table": "causal_edges",
      "filter": { "reasoning_prefix": "decay target" },
      "expected": 60,
      "because": "Cohort 1 sized to match the AC scale target (decay cycle <200ms / 100 edges)."
    },
    {
      "type": "applyConfidenceDecay_result",
      "expected": { "evaluated": 100, "decayed": 60, "expired": 0, "skipped": 40 },
      "because": "Skip cohorts (61..100) sum to 40; decay cohort (1..60) sums to 60; with rate=0.95 strength stays above floor so no expiry."
    },
    {
      "type": "post_decay_strength",
      "filter_cohort": "decay_target",
      "expected_strength_close_to": 0.57,
      "tolerance": 0.001,
      "because": "0.6 * 0.95 = 0.57. All 60 decay targets share the same starting strength."
    },
    {
      "type": "audit_rows_per_decay",
      "filter_cohort": "decay_target",
      "expected_rows": 60,
      "expected_actor": "system_trigger",
      "expected_event_type": "decayed",
      "because": "Phase 2 contract: every decay writes one audit row with actor=system_trigger."
    }
  ],
  "benchmark_targets": {
    "applyConfidenceDecay_p95_ms_for_100_edges": 200,
    "evaluated_count_per_call": 100
  }
}
