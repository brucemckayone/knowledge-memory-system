{
  "scenario": "cyclic-no-span",
  "description": "A→B and B→A active causal edges with no temporal_span. Heuristic flags one row (canonical edge_a_id < edge_b_id).",
  "data_set_level": 1,
  "fixture": "phase5-contradictions/fixtures/cyclic-no-span.sql",
  "phases_exercised": ["detection"],

  "stages": [
    {
      "stage": "detection",
      "driver": "service_call",
      "service_call": "detectCyclicCausal",
      "assertions": [
        {
          "type": "row_count",
          "table": "contradictions",
          "filter": { "contradiction_type": "cyclic_causal", "resolved_at": null },
          "expected": 1,
          "because": "One unresolved cyclic_causal contradiction must be flagged per (A↔B) pair"
        },
        {
          "type": "column_values",
          "table": "contradictions",
          "filter": { "contradiction_type": "cyclic_causal" },
          "assertions": [
            { "column": "edge_a_id", "expected": "30000000-0000-0000-0000-000000000301" },
            { "column": "edge_b_id", "expected": "30000000-0000-0000-0000-000000000302" },
            { "column": "detected_by", "expected": "sql_heuristic" },
            { "column": "severity", "expected": "medium" }
          ]
        },
        {
          "type": "duplicate_rejection",
          "table": "contradictions",
          "filter": { "contradiction_type": "cyclic_causal" },
          "description": "Re-running detection must not create a duplicate row for the same cycle pair",
          "assertion": "row_count_stable_across_runs"
        }
      ]
    }
  ],

  "graduation_notes": "Add cyclic-3-node-loop.sql (A→B, B→C, C→A — heuristic only catches 2-cycles by design; 3+-cycles are reasoning-agent territory)."
}
