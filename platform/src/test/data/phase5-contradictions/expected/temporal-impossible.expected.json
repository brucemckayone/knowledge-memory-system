{
  "scenario": "temporal-impossible",
  "description": "Active causal edge where cause.occurred_at > effect.occurred_at. Effect cannot precede cause; severity always high.",
  "data_set_level": 1,
  "fixture": "phase5-contradictions/fixtures/temporal-impossible.sql",
  "phases_exercised": ["detection"],

  "stages": [
    {
      "stage": "detection",
      "driver": "service_call",
      "service_call": "detectTemporalImpossible",
      "assertions": [
        {
          "type": "row_count",
          "table": "contradictions",
          "filter": { "contradiction_type": "temporal_impossible", "resolved_at": null },
          "expected": 1,
          "because": "One unresolved temporal_impossible contradiction must be flagged for the inverted-time edge"
        },
        {
          "type": "column_values",
          "table": "contradictions",
          "filter": { "contradiction_type": "temporal_impossible" },
          "assertions": [
            { "column": "edge_a_id", "expected": "30000000-0000-0000-0000-000000000501" },
            { "column": "detected_by", "expected": "sql_heuristic" },
            { "column": "severity", "expected": "high" }
          ]
        },
        {
          "type": "duplicate_rejection",
          "table": "contradictions",
          "filter": { "contradiction_type": "temporal_impossible" },
          "description": "Re-running detection must not create a duplicate row for the same edge",
          "assertion": "row_count_stable_across_runs"
        }
      ]
    }
  ],

  "graduation_notes": "Add temporal-edge-cases.sql: (a) cause.occurred_at == effect.occurred_at — equality must NOT flag; (b) microsecond precision inversions — should flag."
}
